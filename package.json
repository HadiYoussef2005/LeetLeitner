{
  "name": "leetleitner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "test:performance": "node scripts/performance-check.mjs",
    "test:restart": "node scripts/persistence-check.mjs",
    "test:portability": "node scripts/portability-check.mjs",
    "prebuild": "node scripts/clean-build.mjs",
    "test:hosting": "node scripts/hosting-check.mjs",
    "test:link-input": "node scripts/link-input-check.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.4"
  }
}
